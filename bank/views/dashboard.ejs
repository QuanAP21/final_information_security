<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SecureBank | Dashboard</title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body class="app-body">
  <div class="bg-grid"></div>

  <%
    const safeLabNotice =
      typeof labNotice !== "undefined" && labNotice ? labNotice : "";

    const safeSameSiteInfo =
      typeof sameSiteInfo !== "undefined" && sameSiteInfo
        ? sameSiteInfo
        : {
            cookieAttribute: "SameSite=Unset",
            summary: "Legacy lab mode.",
            demoHint: "External CSRF may succeed."
          };

    const safeCookieState =
      typeof cookieState !== "undefined" && cookieState
        ? cookieState
        : {
            rawHeaderPresent: false,
            rawHeader: ""
          };
  %>

  <header class="topbar">
    <div class="brand-row">
      <div class="brand-logo small">SB</div>
      <div>
        <p class="eyebrow">SecureBank</p>
        <h2 class="topbar-title">Security Control Center</h2>
      </div>
    </div>

    <div class="topbar-actions">
      <div class="user-pill">
        <span class="user-avatar"><%= username.charAt(0).toUpperCase() %></span>
        <span><%= username %></span>
      </div>
      <a href="/reset" class="btn btn-secondary">Reset Demo</a>
      <a href="/logout" class="btn btn-secondary">Logout</a>
    </div>
  </header>

  <main class="dashboard-shell">
    <section class="security-level-grid">
      <form action="/set-level" method="POST" class="level-form">
        <button
          type="submit"
          name="securityLevel"
          value="low"
          class="level-card <%= securityLevel === 'low' ? 'active low' : '' %>"
        >
          <span class="level-pill">Level A</span>
          <h3>Low</h3>
          <p>No effective protection. External CSRF and Stored XSS + CSRF both succeed.</p>
        </button>
      </form>

      <form action="/set-level" method="POST" class="level-form">
        <button
          type="submit"
          name="securityLevel"
          value="medium"
          class="level-card <%= securityLevel === 'medium' ? 'active medium' : '' %>"
        >
          <span class="level-pill">Level B</span>
          <h3>Medium</h3>
          <p>Blocks only the reward-click external CSRF flow.</p>
        </button>
      </form>

      <form action="/set-level" method="POST" class="level-form">
        <button
          type="submit"
          name="securityLevel"
          value="high"
          class="level-card <%= securityLevel === 'high' ? 'active high' : '' %>"
        >
          <span class="level-pill">Level C</span>
          <h3>High</h3>
          <p>Blocks reward-click CSRF and also prevents Stored XSS + CSRF inside the feed.</p>
        </button>
      </form>
    </section>

    <section class="summary-grid wide-summary">
      <div class="summary-card summary-primary">
        <p class="card-label">Available Balance</p>
        <h1>$<%= myBalance %></h1>
        <p class="card-subtext">Current account balance for <strong><%= username %></strong></p>
      </div>

      <div class="summary-card">
        <p class="card-label">Total Requests</p>
        <h3><%= metrics.totalRequests %></h3>
        <p class="card-subtext">All logged transfer/security requests received by the bank.</p>
      </div>

      <div class="summary-card">
        <p class="card-label">Blocked Requests</p>
        <h3><%= metrics.blockedEvents %></h3>
        <p class="card-subtext">Requests stopped by the current protection level.</p>
      </div>

      <div class="summary-card">
        <p class="card-label">Malicious Notices</p>
        <h3><%= metrics.maliciousNotificationCount %></h3>
        <p class="card-subtext">Stored notifications currently containing hidden payloads.</p>
      </div>

      <div class="summary-card">
        <p class="card-label">Latest Insight</p>
        <h3>Security Feed</h3>
        <p class="card-subtext"><%= metrics.latestInsight %></p>
      </div>
    </section>

    <section class="panel glass">
      <div class="panel-header">
        <div>
          <p class="eyebrow">CSRF Lab Controls</p>
          <h3>SameSite Cookie Lab &amp; Double-Submit Mode</h3>
        </div>
        <span class="badge badge-blue">NEW</span>
      </div>

      <% if (safeLabNotice) { %>
        <div class="admin-alert-banner admin-alert-safe">
          <strong>Lab note</strong>
          <p><%= safeLabNotice %></p>
        </div>
      <% } %>

      <div class="lab-grid">
        <div class="compact-card">
          <h4>Session Cookie Policy</h4>

          <form action="/set-cookie-mode" method="POST" class="feed-publish-form">
            <label class="input-group">
              <span>SameSite mode</span>
              <select name="sameSiteMode" required>
                <option value="unset" <%= sameSiteMode === 'unset' ? 'selected' : '' %>>Unset / Legacy Lab</option>
                <option value="lax" <%= sameSiteMode === 'lax' ? 'selected' : '' %>>Lax</option>
                <option value="strict" <%= sameSiteMode === 'strict' ? 'selected' : '' %>>Strict</option>
                <option value="none" <%= sameSiteMode === 'none' ? 'selected' : '' %>>None (HTTPS only)</option>
              </select>
            </label>

            <button type="submit" class="btn btn-secondary btn-full">Apply Cookie Mode</button>
          </form>

          <div class="token-box">
            <span class="token-label">Current Cookie Policy</span>
            <code><%= safeSameSiteInfo.cookieAttribute %></code>
            <p class="lab-note"><%= safeSameSiteInfo.summary %></p>
            <p class="lab-note"><strong>Demo effect:</strong> <%= safeSameSiteInfo.demoHint %></p>
          </div>
        </div>

        <div class="compact-card">
          <h4>CSRF Token Strategy</h4>

          <form action="/set-csrf-lab-mode" method="POST" class="feed-publish-form">
            <label class="input-group">
              <span>Lab mode</span>
              <select name="csrfLabMode" required>
                <option value="off" <%= csrfLabMode === 'off' ? 'selected' : '' %>>Off</option>
                <option value="double-submit" <%= csrfLabMode === 'double-submit' ? 'selected' : '' %>>Double-Submit Cookie</option>
              </select>
            </label>

            <button type="submit" class="btn btn-secondary btn-full">Apply CSRF Lab Mode</button>
          </form>

          <div class="token-box">
            <span class="token-label">Current CSRF Lab Mode</span>
            <code><%= csrfLabMode === 'double-submit' ? 'Double-Submit Cookie' : 'Off' %></code>
            <p class="lab-note">
              <% if (csrfLabMode === 'double-submit') { %>
                Requests must carry both the <code>XSRF-TOKEN</code> cookie and a matching hidden field.
              <% } else { %>
                Only the original defenses of the demo are active.
              <% } %>
            </p>
          </div>
        </div>

        <div class="compact-card">
          <h4>Session / Cookie Monitor</h4>
          <div class="mini-grid">
            <div class="kv">
              <span>Logged-in user</span>
              <strong><%= username %></strong>
            </div>
            <div class="kv">
              <span>Session cookie seen on this request</span>
              <strong><%= safeCookieState.rawHeaderPresent ? 'YES' : 'NO' %></strong>
            </div>
            <div class="kv">
              <span>Synchronizer token</span>
              <code><%= csrfToken %></code>
            </div>
            <div class="kv">
              <span>XSRF token</span>
              <code><%= xsrfToken %></code>
            </div>
          </div>
          <p class="lab-note">
            Raw cookie header on this request:
            <code><%= safeCookieState.rawHeader || 'none' %></code>
          </p>
        </div>
      </div>
    </section>

    <section class="panel glass phishing-demo-card reward-active">
      <div class="shiny-effect"></div>

      <div class="panel-header">
        <div class="header-content">
          <div class="icon-wrap">🎁</div>
          <div>
            <p class="eyebrow urgent-text">Exclusive Partner Reward</p>
            <h3 class="promo-title">Congratulations! You’ve received a $20 cashback reward</h3>
          </div>
        </div>
        <span class="badge pulse-red">Limited Time</span>
      </div>

      <div class="promo-cta-box">
        <div class="benefit-list">
          <div class="benefit-item">
            <span class="check-icon">✓</span>
            <p>Reward appears to be credited directly to your SecureBank account</p>
          </div>
          <div class="benefit-item">
            <span class="check-icon">✓</span>
            <p>The bank appears to be connecting you to a trusted rewards partner</p>
          </div>
        </div>

        <div class="scarcity-bar">
          <div class="progress" style="width: 85%;"></div>
          <p class="scarcity-label">Only 12 rewards remaining!</p>
        </div>

        <a href="/partner-reward" class="btn btn-reward pulse-animation">
          Claim Reward Now
        </a>
      </div>

    </section>

    <section class="panel glass feed-panel professional-feed-panel">
      <div class="panel-header">
        <div>
          <p class="eyebrow">View-to-Trigger Scenario</p>
          <h3>Notifications Feed</h3>
        </div>

        <% if (securityLevel === 'high') { %>
          <span class="badge badge-safe">SAFE FEED RENDERING</span>
        <% } else { %>
          <span class="badge badge-danger">AUTO-EXECUTION RISK</span>
        <% } %>
      </div>

      <div class="feed-status-line <%= securityLevel === 'high' ? 'safe-mode' : 'unsafe-mode' %>">
        <strong>
          <%= securityLevel === 'high'
            ? 'High level: malicious feed content is rendered safely and cannot execute.'
            : securityLevel === 'medium'
            ? 'Medium level: reward-click CSRF is blocked, but a planted malicious notification can still execute on refresh.'
            : 'Low level: both reward-click CSRF and Stored XSS + CSRF can succeed.' %>
        </strong>
      </div>

      <div class="feed-layout">
        <div class="feed-main">
          <div class="feed-header-row">
            <div>
              <p class="eyebrow">Victim View</p>
              <h4>Latest Bank Notifications</h4>
            </div>
          </div>

          <div class="notification-list">
            <% comments.forEach(function(comment) { %>
              <div class="notification-card <%= securityLevel === 'high' ? 'notification-card-safe' : 'notification-card-unsafe' %>">
                <div class="notification-top">
                  <div class="notification-icon">🔔</div>
                  <div class="comment-meta">
                    <strong><%= comment.author %></strong>
                    <span><%= comment.createdAt %></span>
                  </div>
                </div>

                <% if (securityLevel === 'high') { %>
                  <% const isPayloadLike =
                    comment.content.includes("<script") ||
                    comment.content.includes("fetch(") ||
                    comment.content.includes("attackVector") ||
                    comment.content.includes("stored_xss_payload_"); %>

                  <% if (isPayloadLike) { %>
                    <details class="payload-collapse">
                      <summary>
                        <span class="payload-summary-badge">Escaped malicious notification</span>
                        <span class="payload-summary-text">
                          Payload detected but rendered safely as text.
                        </span>
                      </summary>
                      <pre class="payload-preview"><%= comment.content %></pre>
                    </details>
                  <% } else { %>
                    <div class="safe-text-preview"><%= comment.content %></div>
                  <% } %>
                <% } else { %>
                  <div class="notification-content">
                    <%- comment.content %>
                  </div>
                <% } %>
              </div>
            <% }) %>
          </div>
        </div>

        <aside class="feed-side-panel">
          <div class="compact-card">
            <h4>Feed Information</h4>

            <form action="/comments" method="POST" class="feed-publish-form">
              <textarea
                name="content"
                rows="4"
                placeholder="Publish a normal notification: maintenance, promotion, or account notice..."
                required
              ></textarea>
              <button type="submit" class="btn btn-secondary btn-full">
                Publish Normal Notification
              </button>
            </form>
          </div>

          <% if (securityLevel === 'high') { %>
            <div class="runtime-card">
              <h4>High Runtime Controls</h4>
              <ul class="runtime-list">
                <li>Blocks reward-click external requests</li>
                <li>Requires valid CSRF token for external CSRF flow</li>
                <li>Renders notifications safely as plain text</li>
                <li>Trusted Types + strict CSP enabled</li>
              </ul>
              <div id="tt-demo-box" class="tt-demo-box"></div>
            </div>
          <% } else { %>
            <div class="runtime-card danger-card">
              <h4>Execution Result</h4>
              <p>
                In this mode, a planted payload can execute during page render and update the dashboard immediately after one refresh.
              </p>
            </div>
          <% } %>
        </aside>
      </div>
    </section>

<section class="panel glass partner-services-panel">
  <div class="partner-shell">
    <div class="partner-main-card">
      <div class="partner-top-row">
        <div class="partner-brand">
          <div class="partner-icon">📈</div>
          <div>
            <p class="partner-eyebrow">Strategic Partnerships</p>
            <h3>Market Insights & Financial Perks</h3>
          </div>
        </div>
        <span class="partner-badge">Integrated Module</span>
      </div>

      <div class="partner-content-grid">
        <div class="partner-copy">
          <div class="partner-label">SecureBank Marketplace</div>
          <h4>Exclusive Announcements for Retail Clients</h4>
          <p>
            Access real-time insurance premiums, curated FX rates, and premium 
            financial content synchronized via our third-party provider ecosystem.
          </p>

          <div class="partner-actions">
            <a href="/partner-dom-lab" class="partner-cta">
              Explore Offers
            </a>
            <span class="partner-chip">Affiliate Content</span>
            <span class="partner-chip">Sandbox Environment</span>
          </div>
        </div>

        <div class="partner-metrics">
          <div class="partner-metric-card">
            <span>USD/VND Spot</span>
            <strong>25,420</strong>
            <small>Mid-market rate</small>
          </div>
          <div class="partner-metric-card">
            <span>Health Premium</span>
            <strong>-12%</strong>
            <small>Preferential rate</small>
          </div>
          <div class="partner-metric-card">
            <span>Partner Feed</span>
            <strong>3 active</strong>
            <small>Last updated: Today</small>
          </div>
        </div>
      </div>
    </div>

    <aside class="partner-side-card">
      <div class="partner-side-header">
        <span>🧩</span>
        <strong>Integrated Portfolio</strong>
      </div>
      <p>
        Unified access to bancassurance products, foreign exchange analytics, 
        and partner-led financial advisories.
      </p>
      <div class="partner-side-list">
        <div><span>✓</span> Health Insurance Privileges</div>
        <div><span>✓</span> FX Summaries & Fee Schedules</div>
        <div><span>✓</span> Synced Provider Content</div>
      </div>
    </aside>
  </div>
</section>

    <section class="two-panel-grid">
      <section class="panel glass">
        <div class="panel-header">
          <div>
            <p class="eyebrow">Transaction</p>
            <h3>Transfer Funds</h3>
          </div>
          <span class="badge badge-blue"><%= securityLevel.toUpperCase() %> SECURITY</span>
        </div>

        <form action="/transfer" method="POST" class="transfer-form">
          <input type="hidden" name="attackVector" value="legitimate-form" />
          <input type="hidden" name="csrfToken" id="globalCsrfToken" value="<%= csrfToken %>" />
          <input type="hidden" name="xsrfToken" id="globalXsrfToken" value="<%= xsrfToken %>" />

          <label class="input-group">
            <span>Recipient</span>
            <select name="to" required>
              <% users.forEach(function(user) { %>
                <option value="<%= user %>"><%= user %></option>
              <% }) %>
            </select>
          </label>

          <label class="input-group">
            <span>Amount</span>
            <input type="number" name="amount" min="1" placeholder="Enter amount" required />
          </label>

          <div class="token-box">
            <span class="token-label">CSRF Token</span>
            <code><%= csrfToken %></code>
          </div>

          <div class="token-box">
            <span class="token-label">Double-Submit XSRF Token</span>
            <code><%= xsrfToken %></code>
          </div>

          <button type="submit" class="btn btn-primary">Send Money</button>
        </form>
      </section>

      <section class="panel glass">
        <div class="panel-header">
          <div>
            <p class="eyebrow">Admin Snapshot</p>
            <h3>Live Accounts</h3>
          </div>
          <span class="badge">Balances</span>
        </div>

        <div class="account-list">
          <% allAccounts.forEach(function(account) { %>
            <div class="account-item">
              <div class="account-left">
                <div class="account-avatar"><%= account.username.charAt(0).toUpperCase() %></div>
                <div>
                  <h4><%= account.username %></h4>
                  <p><%= account.username === username ? 'Logged-in user' : 'Tracked account' %></p>
                </div>
              </div>
              <div class="account-balance">$<%= account.balance %></div>
            </div>
          <% }) %>
        </div>
      </section>
    </section>

    <section class="panel glass panel-table">
      <div class="panel-header">
        <div>
          <p class="eyebrow">Admin Event Center</p>
          <h3>Security Dashboard</h3>
        </div>
        <span class="badge badge-dark"><%= events.length %> Events</span>
      </div>

      <% if (metrics.maliciousNotificationCount > 0) { %>
        <div class="admin-alert-banner <%= securityLevel === 'high' ? 'admin-alert-safe' : 'admin-alert-danger' %>">
          <% if (securityLevel === 'high') { %>
            <strong>
              <%= metrics.neutralizedNotificationCount %> malicious notification(s) are present in the feed but were neutralized before execution.
            </strong>
            <p>
              No forged transfer request reached the server, so you may not see a separate blocked transfer row for those notifications.
            </p>
          <% } else { %>
            <strong>
              <%= metrics.maliciousNotificationCount %> malicious notification(s) are present in the feed.
            </strong>
            <p>
              Refreshing the dashboard once may immediately execute the payload in the current protection level.
            </p>
          <% } %>
        </div>
      <% } %>

      <% if (events.length === 0) { %>
        <div class="empty-state">
          <div class="empty-icon">📄</div>
          <h4>No security events yet</h4>
          <p>Use the reward flow or the attacker console to generate demo logs.</p>
        </div>
      <% } else { %>
        <div class="table-wrap">
          <table class="modern-table">
            <thead>
              <tr>
                <th>Time</th>
                <th>Level</th>
                <th>Vector</th>
                <th>Status</th>
                <th>Amount</th>
                <th>Reason</th>
              </tr>
            </thead>
            <tbody>
              <% events.forEach(function(event) { %>
                <tr>
                  <td><%= event.time %></td>
                  <td><span class="table-pill"><%= event.level %></span></td>
                  <td><%= event.attackVector %></td>
                  <td>
                    <span class="status-chip <%= event.status === 'SUCCESS' ? 'success' : event.status === 'BLOCKED' ? 'blocked' : 'warning' %>">
                      <%= event.status %>
                    </span>
                  </td>
                  <td>$<%= event.amount %></td>
                  <td><%= event.reason %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>
  </main>

  <script nonce="<%= cspNonce %>" src="/dom-xss-lab.js"></script>

  <% if (securityLevel === 'high') { %>
    <script nonce="<%= cspNonce %>" src="/high-security.js"></script>
  <% } %>
</body>
</html>