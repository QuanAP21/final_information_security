<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SecureBank | Strategic Partner Offers</title>
  <link rel="stylesheet" href="/styles.css" />
</head>

<body class="app-body partner-lab-body">
  <div class="partner-lab-bg"></div>

  <main class="partner-lab-shell">
    <section class="partner-lab-card">
      <header class="partner-lab-header">
        <div class="partner-lab-brand">
          <div class="partner-lab-logo">SB</div>
          <div>
            <p>SecureBank Partner Hub</p>
            <h1>Market Insights & Partner Privileges</h1>
          </div>
        </div>
        <span class="partner-lab-status">Integrated Partner Module</span>
      </header>

      <div class="partner-lab-hero">
        <div>
          <p class="partner-lab-kicker">Personalized Financial Content</p>
          <h2>Exclusive Insights & Perks for Retail Clients</h2>
          <p class="partner-lab-desc">
            SecureBank is synchronizing exclusive promotional content, reference FX rates, and policy benefits 
            from our partner ecosystem to match your authenticated profile.
          </p>
        </div>

        <div class="partner-lab-summary">
          <div>
            <span>USD/VND Spot</span>
            <strong>25,420</strong>
          </div>
          <div>
            <span>Partner Offer</span>
            <strong>-12% APR</strong>
          </div>
          <div>
            <span>Last Updated</span>
            <strong>Today</strong>
          </div>
        </div>
      </div>

      <section class="partner-lab-content">
        <div class="partner-lab-widget">
          <div class="partner-widget-top">
            <div class="partner-widget-icon">📈</div>
            <div>
              <h3>SecureBank Market & Benefits</h3>
              <p>Integrated financial content widget</p>
            </div>
          </div>

          <div id="partnerPromoMount" class="partner-promo-mount">
            <div class="partner-loading-line"></div>
            <strong>Retrieving exclusive offers...</strong>
            <p>
              Please wait while the system synchronizes content from our partner network.
            </p>
          </div>
        </div>

        <aside class="partner-lab-side">
          <h3>Module Information</h3>

          <div class="partner-side-list">
            <div><span>✓</span> Partner offer data</div>
            <div><span>✓</span> Market reference content</div>
            <div><span>✓</span> Client-side rendering flow</div>
          </div>
        </aside>
      </section>

      <input type="hidden" id="globalCsrfToken" value="<%= csrfToken %>" />
      <input type="hidden" id="globalXsrfToken" value="<%= xsrfToken %>" />

      <footer class="partner-lab-actions">
        <button id="backToDashboardBtn" class="partner-btn partner-btn-primary">
          Return to Dashboard
        </button>
      </footer>
    </section>
  </main>

  <iframe
    src="<%= attackerOrigin %>/partner-message.html?attemptId=<%= domAttemptId %>"
    title="partner promo source"
    style="display:none;"
  ></iframe>

  <script nonce="<%= cspNonce %>">
    const securityLevel = "<%= securityLevel %>";
    const partnerPromoMount = document.getElementById("partnerPromoMount");
    const domAttemptId = "<%= domAttemptId %>";
    const backBtn = document.getElementById("backToDashboardBtn");

    let pendingPartnerHtml = "";

    window.addEventListener("message", function (event) {
      if (!event.data || event.data.type !== "partner-promo-html") return;
      if (event.data.attemptId !== domAttemptId) return;

      pendingPartnerHtml = event.data.html || "";

      partnerPromoMount.innerHTML = `
        <div class="partner-ready-badge">Content Synchronized</div>
        <strong>Exclusive Financial Perks for SecureBank Clients</strong>
        <p>
          Your personalized partner content is ready. You may now return to your Dashboard
          to continue managing your accounts and viewing the latest notifications.
        </p>

        <div class="partner-ready-grid">
          <div>
            <span>USD/VND Spot</span>
            <code>25,420</code>
          </div>
          <div>
            <span>Partner Offer</span>
            <code>-12% APR</code>
          </div>
          <div>
            <span>Last Updated</span>
            <code>Today</code>
          </div>
        </div>
      `;
    });

    backBtn.addEventListener("click", async function () {
      if (securityLevel === "high") {
        partnerPromoMount.textContent = pendingPartnerHtml || "Partner content was neutralized safely.";

        const body = new URLSearchParams({
          attemptId: domAttemptId
        });

        try {
          await fetch("/dom-attack-neutralized", {
            method: "POST",
            headers: {
              "Content-Type": "application/x-www-form-urlencoded"
            },
            credentials: "same-origin",
            body: body.toString()
          });
        } catch (err) {
          console.error("DOM neutralization callback failed:", err);
        }

        window.location.href = "/dashboard";
        return;
      }

      if (!pendingPartnerHtml) {
        window.location.href = "/dashboard";
        return;
      }

      partnerPromoMount.innerHTML = pendingPartnerHtml;
    });
  </script>
</body>
</html>