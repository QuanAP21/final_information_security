<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SecureBank | Result</title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body class="success-body">
  <div class="bg-orb orb-1"></div>
  <div class="bg-orb orb-2"></div>

  <main class="success-layout">
    <section class="success-card glass">
      <div class="success-icon <%= type %>">
        <%= type === 'success' ? '✓' : type === 'blocked' ? '🛡' : '!' %>
      </div>

      <p class="eyebrow">Transaction Result</p>
      <h1><%= title %></h1>
      <p class="success-text"><%= message %></p>

      <div class="result-detail-box">
        <p><%= detail %></p>
      </div>

      <div class="success-actions" style="display:flex; gap:12px; flex-wrap:wrap;">
        <a href="/dashboard" class="btn btn-primary">Back to Dashboard</a>
        <a href="http://localhost:4000" target="_blank" class="btn btn-secondary">
          Open Attacker Page (Core Demo)
        </a>
        <a href="http://127.0.0.1:4000" target="_blank" class="btn btn-secondary">
          Open Attacker Page (SameSite Lab)
        </a>
      </div>
    </section>
  </main>
</body>
</html>